{
	admin off
	persist_config off
	auto_https off

	log {
		format json
		output stderr
		level WARN
	}

	# php-fpm ran pm.max_children = 50 (18 started), so max_threads keeps the
	# same concurrency ceiling. Requests here are mostly I/O-bound (Postgres,
	# Redis, S3, the SSR server, OpenRouter), and every open AI chat stream
	# holds one PHP thread for its whole life (up to 210s, the kit's
	# max_stream_seconds + 30), so 8 threads start warm and the pool grows on
	# demand (up to max_threads) — the VPS is shared, and idle warm threads
	# are memory other apps cannot use. Requests beyond max_threads queue
	# for max_wait_time, then get a 504.
	#
	# Worker mode (Laravel Octane): the app boots once per worker and serves
	# request after request instead of bootstrapping Laravel on every hit.
	# start-container.sh fills FRANKENPHP_WORKER and PHP_ENTRY unless
	# OCTANE_WORKERS=false, which falls back to classic per-request mode
	# (public/index.php) with no redeploy of code: flip the env in Coolify
	# and restart. The worker threads are a small fixed pool on top of the
	# classic ones above, which keep serving writes, AI streams and other
	# slow requests (see php_server below).
	frankenphp {
		num_threads 8
		max_threads 50
		max_wait_time 30s
		{$FRANKENPHP_WORKER}
	}
}

:{$PORT:80} {
	root * /app/public

	# nginx capped request bodies at client_max_body_size 35M; php.ini's
	# post_max_size matches. The largest upload the app validates is 20MB.
	request_body {
		max_size 35MB
	}

	header X-Content-Type-Options "nosniff"
	header -Server

	# No other site may frame the guide or the /manage panel (clickjacking a
	# signed-in admin into a click). CSP frame-ancestors for current browsers,
	# X-Frame-Options for old ones. Nothing in the app frames itself.
	header Content-Security-Policy "frame-ancestors 'self'"
	header X-Frame-Options "SAMEORIGIN"
	# Other origins get only our origin as Referer (the browsers' default,
	# pinned so no old client sends the full URL).
	header Referrer-Policy "strict-origin-when-cross-origin"

	# nginx denied every dotfile path except /.well-known.
	@dotfiles {
		path_regexp /\.
		not path /.well-known/*
	}
	respond @dotfiles 404

	# Compress an explicit allowlist only. text/event-stream is deliberately
	# absent: AI replies stream as SSE and must reach the client frame by
	# frame, never held back in an encoder buffer.
	encode {
		zstd
		gzip
		minimum_length 1024
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}

	# Worker mode serves the short, hot GETs from the Octane workers: pages,
	# Inertia visits, full-page cache hits. Everything that can hold a thread
	# for seconds or minutes runs on the classic threads instead, exactly as
	# in classic mode, where the pool grows on demand up to max_threads:
	# every write (logins, admin saves, uploads, the AI chat and assistant
	# turns that answer as an event stream), the event-stream resumes, the
	# AI search (an embeddings call), corpus file downloads and social-card
	# renders. The worker pool is small and fixed (start-container.sh), so a
	# few slow requests on it would stall every visitor; and a stream gains
	# nothing from a booted app. OctaneWorkerModeTest checks every
	# event-stream route lands here.
	@classic_writes not method GET HEAD
	rewrite @classic_writes /index.php
	@classic_slow path_regexp classic_slow ^/(ai/chat/turns/[^/]+/stream|manage/assistant/turns/[^/]+/stream|bahth|mstnd/.+|_og-image(/.*)?)$
	rewrite @classic_slow /index.php

	php_server {
		index {$PHP_ENTRY:index.php}
		try_files {path} {$PHP_ENTRY:index.php}
	}
}
